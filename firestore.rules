rules_version = '2';
// Security rules for Star Voyager (paste into Firebase console → Firestore Database → Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account can only read and write its own saved progress
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.save is string
                   && request.resource.data.save.size() < 900000;
    }
    // Licences: the player may only read their own; only the server (after a payment) writes them
    match /licenses/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
